{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "style_id": {
            "type": "string",
            "enum": [
                "default"
            ],
            "default": "default"
        },
        "filled": {
            "type": "boolean",
            "default": false
        },
        "stroke_width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16,
            "default": 2
        },
        "corner_radius": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "default": 0
        }
    }
}