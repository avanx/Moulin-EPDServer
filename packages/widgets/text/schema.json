{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "style_id": {
            "type": "string",
            "enum": [
                "default",
                "boxed"
            ],
            "default": "default"
        },
        "text": {
            "type": "string",
            "default": "Hello EPD"
        },
        "font_size": {
            "type": "integer",
            "minimum": 8,
            "maximum": 160,
            "default": 32
        },
        "align": {
            "type": "string",
            "enum": [
                "left",
                "center",
                "right"
            ],
            "default": "left"
        }
    }
}