{
    "sections": [
        {
            "title": {
                "zh-CN": "文字内容",
                "en": "Content"
            },
            "description": {
                "zh-CN": "设置显示文字及排版方式",
                "en": "Set the displayed text and typography"
            },
            "fields": [
                "text",
                "font_size",
                "align"
            ]
        },
        {
            "title": {
                "zh-CN": "颜色",
                "en": "Colors"
            },
            "description": {
                "zh-CN": "仅列出当前屏幕支持的颜色；红 / 黄需要多色屏",
                "en": "Only colors supported by the current screen are listed; red / yellow need a multi-color screen"
            },
            "fields": [
                "color",
                "background"
            ]
        }
    ],
    "fields": {
        "text": {
            "control": "textarea",
            "label": {
                "zh-CN": "显示文字",
                "en": "Text"
            },
            "placeholder": {
                "zh-CN": "输入要显示的内容",
                "en": "Enter text"
            },
            "rows": 3
        },
        "font_size": {
            "control": "range",
            "label": {
                "zh-CN": "字号",
                "en": "Font size"
            },
            "min": 8,
            "max": 160,
            "step": 1,
            "suffix": " px"
        },
        "align": {
            "control": "segmented",
            "label": {
                "zh-CN": "对齐",
                "en": "Alignment"
            },
            "options": [
                {
                    "value": "left",
                    "label": {
                        "zh-CN": "左",
                        "en": "Left"
                    }
                },
                {
                    "value": "center",
                    "label": {
                        "zh-CN": "中",
                        "en": "Center"
                    }
                },
                {
                    "value": "right",
                    "label": {
                        "zh-CN": "右",
                        "en": "Right"
                    }
                }
            ]
        },
        "color": {
            "control": "color",
            "label": {
                "zh-CN": "文字颜色",
                "en": "Text color"
            },
            "options": [
                {
                    "value": "black",
                    "label": {
                        "zh-CN": "黑",
                        "en": "Black"
                    }
                },
                {
                    "value": "white",
                    "label": {
                        "zh-CN": "白",
                        "en": "White"
                    }
                },
                {
                    "value": "red",
                    "label": {
                        "zh-CN": "红",
                        "en": "Red"
                    }
                },
                {
                    "value": "yellow",
                    "label": {
                        "zh-CN": "黄",
                        "en": "Yellow"
                    }
                }
            ]
        },
        "background": {
            "control": "color",
            "label": {
                "zh-CN": "背景颜色",
                "en": "Background"
            },
            "options": [
                {
                    "value": "white",
                    "label": {
                        "zh-CN": "白",
                        "en": "White"
                    }
                },
                {
                    "value": "black",
                    "label": {
                        "zh-CN": "黑",
                        "en": "Black"
                    }
                },
                {
                    "value": "red",
                    "label": {
                        "zh-CN": "红",
                        "en": "Red"
                    }
                },
                {
                    "value": "yellow",
                    "label": {
                        "zh-CN": "黄",
                        "en": "Yellow"
                    }
                }
            ]
        }
    },
    "style": {
        "accent": "#2563eb",
        "surface": "#eff6ff",
        "border": "#bfdbfe",
        "label": "#1e3a8a",
        "radius": 10
    }
}
