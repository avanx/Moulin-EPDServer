{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
        "compatibility",
        "host"
    ],
    "additionalProperties": false,
    "properties": {
        "style_id": {
            "type": "string",
            "enum": [
                "default"
            ],
            "default": "default"
        },
        "compatibility": {
            "type": "string",
            "enum": [
                "general",
                "snapmaker_u1"
            ],
            "default": "general"
        },
        "host": {
            "type": "string",
            "pattern": "^(10\\.(?:\\d{1,3}\\.){2}\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01])\\.(?:\\d{1,3}\\.)\\d{1,3}|192\\.168\\.(?:\\d{1,3}\\.)\\d{1,3})$",
            "description": "printer private IPv4 address"
        },
        "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "default": 0,
            "description": "0 uses the compatibility mode default port"
        },
        "api_secret_id": {
            "type": "string",
            "default": "",
            "description": "optional Moonraker API key secret id or name"
        },
        "title": {
            "type": "string",
            "default": "Klipper 打印"
        },
        "cache_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 1
        },
        "show_task_name": {
            "type": "boolean",
            "default": true
        }
    }
}