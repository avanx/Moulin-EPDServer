{
    "sections": [
        {
            "title": {
                "zh-CN": "账户",
                "en": "Account"
            },
            "description": {
                "zh-CN": "先登录 Cursor Dashboard，按 F12 打开“网络”，将包含 Cookie 的请求复制为 cURL (bash)，再到“密钥管理”粘贴并保存。",
                "en": "Sign in to Cursor Dashboard, open Network with F12, copy a request containing cookies as cURL (bash), then paste and save it in Secrets."
            },
            "fields": [
                "secret_id"
            ]
        },
        {
            "title": {
                "zh-CN": "卡片显示",
                "en": "Card display"
            },
            "fields": [
                "title",
                "show_border",
                "cache_minutes"
            ]
        }
    ],
    "fields": {
        "secret_id": {
            "control": "text",
            "label": {
                "zh-CN": "密钥 ID 或名称",
                "en": "Secret ID or name"
            },
            "placeholder": {
                "zh-CN": "例如 cursor-session",
                "en": "For example, cursor-session"
            },
            "help": {
                "zh-CN": "填写密钥管理中显示的 ID 或名称，不要在这里填写 Token；详细步骤见 cursor_usage/README.md",
                "en": "Enter the ID or name shown in Secrets, not the token itself. See cursor_usage/README.md for detailed steps."
            }
        },
        "title": {
            "control": "text",
            "label": {
                "zh-CN": "卡片标题",
                "en": "Card title"
            }
        },
        "show_border": {
            "control": "toggle",
            "label": {
                "zh-CN": "显示外框（紧凑数字）",
                "en": "Show outer border (compact style)"
            }
        },
        "cache_minutes": {
            "control": "range",
            "label": {
                "zh-CN": "更新间隔",
                "en": "Refresh interval"
            },
            "min": 5,
            "max": 120,
            "step": 5,
            "suffix": {
                "zh-CN": " 分钟",
                "en": " min"
            }
        }
    },
    "style": {
        "accent": "#059669",
        "surface": "#ecfdf5",
        "border": "#a7f3d0",
        "label": "#064e3b",
        "radius": 10
    }
}