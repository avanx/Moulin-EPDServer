# 可选：不设置时服务端自动生成并内部管理（写入数据目录）
# EPD_MASTER_KEY=replace-with-at-least-32-random-characters
EPD_ADMIN_USERNAME=admin
EPD_ADMIN_PASSWORD=replace-with-a-strong-password
EPD_ALLOWED_ORIGINS=http://localhost:5088
EPD_COOKIE_SECURE=false
EPD_WEB_PORT=5088
EPD_SNAPSHOT_KEEP=3
# Docker 构建国内镜像开关（默认启用；设为 0 关闭）
# EPD_APT_MIRROR=0   # Debian apt / Alpine apk → 阿里云
# EPD_NPM_MIRROR=0   # npm / Playwright → npmmirror（原生 epdctl 同样识别）
# 编译版本（可选；原生 epdctl 构建时自动写入；Docker 构建可传入）
# EPD_VERSION=0.1.0
# EPD_GIT_SHA=
# EPD_BUILD_TIME=
# 原生部署时由 scripts/epdctl.sh 自动设置为 frontend/dist；Docker 部署可忽略
# EPD_FRONTEND_DIR=
